      "policies": {
        "opportunity_demand_facts_select_member": {
          "name": "opportunity_demand_facts_select_member",
          "as": "PERMISSIVE",
          "for": "SELECT",
          "to": [
            "authenticated"
          ],
          "using": "\"opportunity_demand_facts\".\"organization_id\" IN (SELECT private.user_org_ids())"
        },
        "opportunity_demand_facts_insert_member": {
          "name": "opportunity_demand_facts_insert_member",
          "as": "PERMISSIVE",
          "for": "INSERT",
          "to": [
            "authenticated"
          ],
          "withCheck": "\"opportunity_demand_facts\".\"organization_id\" IN (SELECT private.user_org_ids()) AND \"opportunity_demand_facts\".\"source_kind\" = 'member' AND \"opportunity_demand_facts\".\"status\" IN ('confirmed', 'corrected', 'rejected') AND \"opportunity_demand_facts\".\"recorded_by\" = (select auth.uid()) AND \"opportunity_demand_facts\".\"recorded_at\" = now()"
        }
      },
      "checkConstraints": {
        "opportunity_demand_facts_fact_check": {
          "name": "opportunity_demand_facts_fact_check",
          "value": "\"opportunity_demand_facts\".\"fact\" IN ('desired_vehicle', 'year_range', 'budget_max', 'purchase_type', 'trade_in_intent', 'down_payment')"
        },
        "opportunity_demand_facts_status_check": {
          "name": "opportunity_demand_facts_status_check",
          "value": "\"opportunity_demand_facts\".\"status\" IN ('detected', 'confirmed', 'corrected', 'rejected')"
        },
        "opportunity_demand_facts_source_kind_check": {
          "name": "opportunity_demand_facts_source_kind_check",
          "value": "\"opportunity_demand_facts\".\"source_kind\" IN ('member')"
        },
        "opportunity_demand_facts_currency_check": {
          "name": "opportunity_demand_facts_currency_check",
          "value": "\"opportunity_demand_facts\".\"currency\" IN ('PYG', 'USD')"
        },
        "opportunity_demand_facts_purchase_type_check": {
          "name": "opportunity_demand_facts_purchase_type_check",
          "value": "\"opportunity_demand_facts\".\"purchase_type\" IN ('cash', 'financed', 'undecided')"
        },
        "opportunity_demand_facts_value_check": {
          "name": "opportunity_demand_facts_value_check",
          "value": "CASE\n        WHEN \"opportunity_demand_facts\".\"status\" = 'rejected' THEN num_nonnulls(\"opportunity_demand_facts\".\"brand\", \"opportunity_demand_facts\".\"model\", \"opportunity_demand_facts\".\"year_min\", \"opportunity_demand_facts\".\"year_max\", \"opportunity_demand_facts\".\"amount\", \"opportunity_demand_facts\".\"currency\", \"opportunity_demand_facts\".\"purchase_type\", \"opportunity_demand_facts\".\"trade_in\") = 0\n        WHEN \"opportunity_demand_facts\".\"fact\" = 'desired_vehicle' THEN num_nonnulls(\"opportunity_demand_facts\".\"brand\", \"opportunity_demand_facts\".\"model\") >= 1 AND num_nonnulls(\"opportunity_demand_facts\".\"year_min\", \"opportunity_demand_facts\".\"year_max\", \"opportunity_demand_facts\".\"amount\", \"opportunity_demand_facts\".\"currency\", \"opportunity_demand_facts\".\"purchase_type\", \"opportunity_demand_facts\".\"trade_in\") = 0\n        WHEN \"opportunity_demand_facts\".\"fact\" = 'year_range' THEN num_nonnulls(\"opportunity_demand_facts\".\"year_min\", \"opportunity_demand_facts\".\"year_max\") >= 1 AND coalesce(\"opportunity_demand_facts\".\"year_min\" BETWEEN 1900 AND 2100, true) AND coalesce(\"opportunity_demand_facts\".\"year_max\" BETWEEN 1900 AND 2100, true) AND coalesce(\"opportunity_demand_facts\".\"year_min\" <= \"opportunity_demand_facts\".\"year_max\", true) AND num_nonnulls(\"opportunity_demand_facts\".\"brand\", \"opportunity_demand_facts\".\"model\", \"opportunity_demand_facts\".\"amount\", \"opportunity_demand_facts\".\"currency\", \"opportunity_demand_facts\".\"purchase_type\", \"opportunity_demand_facts\".\"trade_in\") = 0\n        WHEN \"opportunity_demand_facts\".\"fact\" = 'budget_max' THEN num_nonnulls(\"opportunity_demand_facts\".\"amount\", \"opportunity_demand_facts\".\"currency\") = 2 AND \"opportunity_demand_facts\".\"amount\" > 0 AND (\"opportunity_demand_facts\".\"currency\" <> 'PYG' OR \"opportunity_demand_facts\".\"amount\" = trunc(\"opportunity_demand_facts\".\"amount\")) AND num_nonnulls(\"opportunity_demand_facts\".\"brand\", \"opportunity_demand_facts\".\"model\", \"opportunity_demand_facts\".\"year_min\", \"opportunity_demand_facts\".\"year_max\", \"opportunity_demand_facts\".\"purchase_type\", \"opportunity_demand_facts\".\"trade_in\") = 0\n        WHEN \"opportunity_demand_facts\".\"fact\" = 'down_payment' THEN num_nonnulls(\"opportunity_demand_facts\".\"amount\", \"opportunity_demand_facts\".\"currency\") = 2 AND \"opportunity_demand_facts\".\"amount\" >= 0 AND (\"opportunity_demand_facts\".\"currency\" <> 'PYG' OR \"opportunity_demand_facts\".\"amount\" = trunc(\"opportunity_demand_facts\".\"amount\")) AND num_nonnulls(\"opportunity_demand_facts\".\"brand\", \"opportunity_demand_facts\".\"model\", \"opportunity_demand_facts\".\"year_min\", \"opportunity_demand_facts\".\"year_max\", \"opportunity_demand_facts\".\"purchase_type\", \"opportunity_demand_facts\".\"trade_in\") = 0\n        WHEN \"opportunity_demand_facts\".\"fact\" = 'purchase_type' THEN \"opportunity_demand_facts\".\"purchase_type\" IS NOT NULL AND num_nonnulls(\"opportunity_demand_facts\".\"brand\", \"opportunity_demand_facts\".\"model\", \"opportunity_demand_facts\".\"year_min\", \"opportunity_demand_facts\".\"year_max\", \"opportunity_demand_facts\".\"amount\", \"opportunity_demand_facts\".\"currency\", \"opportunity_demand_facts\".\"trade_in\") = 0\n        WHEN \"opportunity_demand_facts\".\"fact\" = 'trade_in_intent' THEN \"opportunity_demand_facts\".\"trade_in\" IS NOT NULL AND num_nonnulls(\"opportunity_demand_facts\".\"brand\", \"opportunity_demand_facts\".\"model\", \"opportunity_demand_facts\".\"year_min\", \"opportunity_demand_facts\".\"year_max\", \"opportunity_demand_facts\".\"amount\", \"opportunity_demand_facts\".\"currency\", \"opportunity_demand_facts\".\"purchase_type\") = 0\n        ELSE false\n      END"
        },
        "opportunity_demand_facts_status_target_check": {
          "name": "opportunity_demand_facts_status_target_check",
          "value": "(\"opportunity_demand_facts\".\"status\" NOT IN ('rejected', 'corrected') OR \"opportunity_demand_facts\".\"target_fact_id\" IS NOT NULL) AND (\"opportunity_demand_facts\".\"status\" <> 'detected' OR (\"opportunity_demand_facts\".\"target_fact_id\" IS NULL AND \"opportunity_demand_facts\".\"previous_member_fact_id\" IS NULL))"
        },
        "opportunity_demand_facts_source_status_check": {
          "name": "opportunity_demand_facts_source_status_check",
          "value": "(\"opportunity_demand_facts\".\"status\" = 'detected') = (\"opportunity_demand_facts\".\"source_kind\" <> 'member')"
        },
        "opportunity_demand_facts_member_author_check": {
          "name": "opportunity_demand_facts_member_author_check",
          "value": "\"opportunity_demand_facts\".\"source_kind\" <> 'member' OR \"opportunity_demand_facts\".\"recorded_by\" IS NOT NULL"
        },
        "opportunity_demand_facts_member_chain_check": {
          "name": "opportunity_demand_facts_member_chain_check",
          "value": "\"opportunity_demand_facts\".\"source_kind\" = 'member' OR \"opportunity_demand_facts\".\"previous_member_fact_id\" IS NULL"
        },
        "opportunity_demand_facts_self_reference_check": {
          "name": "opportunity_demand_facts_self_reference_check",
          "value": "(\"opportunity_demand_facts\".\"target_fact_id\" IS NULL OR \"opportunity_demand_facts\".\"target_fact_id\" <> \"opportunity_demand_facts\".\"id\") AND (\"opportunity_demand_facts\".\"previous_member_fact_id\" IS NULL OR \"opportunity_demand_facts\".\"previous_member_fact_id\" <> \"opportunity_demand_facts\".\"id\")"
        },
        "opportunity_demand_facts_text_check": {
          "name": "opportunity_demand_facts_text_check",
          "value": "(\"opportunity_demand_facts\".\"brand\" IS NULL OR (char_length(\"opportunity_demand_facts\".\"brand\") BETWEEN 1 AND 40 AND \"opportunity_demand_facts\".\"brand\" = btrim(\"opportunity_demand_facts\".\"brand\") AND \"opportunity_demand_facts\".\"brand\" !~ '[[:cntrl:]]')) AND (\"opportunity_demand_facts\".\"model\" IS NULL OR (char_length(\"opportunity_demand_facts\".\"model\") BETWEEN 1 AND 80 AND \"opportunity_demand_facts\".\"model\" = btrim(\"opportunity_demand_facts\".\"model\") AND \"opportunity_demand_facts\".\"model\" !~ '[[:cntrl:]]')) AND (\"opportunity_demand_facts\".\"evidence_text\" IS NULL OR (char_length(\"opportunity_demand_facts\".\"evidence_text\") BETWEEN 1 AND 500 AND \"opportunity_demand_facts\".\"evidence_text\" = btrim(\"opportunity_demand_facts\".\"evidence_text\") AND \"opportunity_demand_facts\".\"evidence_text\" !~ '[[:cntrl:]]'))"
        }
      },
      "isRLSEnabled": true
    }
