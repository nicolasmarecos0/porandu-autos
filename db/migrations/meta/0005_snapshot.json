          ],
          "withCheck": "\"vehicles\".\"organization_id\" IN (SELECT private.user_org_ids()) AND \"vehicles\".\"status\" = 'in_preparation'"
        }
      },
      "checkConstraints": {
        "vehicles_status_check": {
          "name": "vehicles_status_check",
          "value": "\"vehicles\".\"status\" IN ('in_preparation', 'available', 'reserved', 'sold')"
        },
        "vehicles_currency_check": {
          "name": "vehicles_currency_check",
          "value": "\"vehicles\".\"currency\" IN ('PYG', 'USD')"
        },
        "vehicles_price_check": {
          "name": "vehicles_price_check",
          "value": "(\"vehicles\".\"price\" IS NULL) = (\"vehicles\".\"currency\" IS NULL) AND (\"vehicles\".\"price\" IS NULL OR (\"vehicles\".\"price\" > 0 AND (\"vehicles\".\"currency\" <> 'PYG' OR \"vehicles\".\"price\" = trunc(\"vehicles\".\"price\"))))"
        },
        "vehicles_year_check": {
          "name": "vehicles_year_check",
          "value": "\"vehicles\".\"year\" BETWEEN 1900 AND 2100"
        },
        "vehicles_km_check": {
          "name": "vehicles_km_check",
          "value": "\"vehicles\".\"km\" IS NULL OR \"vehicles\".\"km\" >= 0"
        }
