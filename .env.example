# Porandú Autos: contrato de variables de entorno (H0, ADR-001).
# Copiar a .env.local y reemplazar cada <placeholder>. Nunca commitear valores reales.
# Local: URL y publishable key salen de `pnpm sb:status`.

# --- Públicas: se incrustan en el bundle del navegador ---------------------

# URL del proyecto Supabase. Local: http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_URL=<supabase-url>
# Publishable key (sb_publishable_…). Nunca una secret key (sb_secret_…).
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=<sb_publishable_key>

# --- Server-only: nunca con prefijo NEXT_PUBLIC_ ---------------------------

# Runtime de la aplicación. Rol app_runtime (NOBYPASSRLS), nunca postgres.
# La migración crea el rol sin password: se fija fuera de las migraciones (ver README).
# Staging: Supavisor en modo transacción, puerto 6543, usuario app_runtime.<project_ref>.
RUNTIME_DATABASE_URL=postgresql://app_runtime:<password>@<host>:<port>/postgres

# Solo migraciones (drizzle-kit). Rol postgres. El runtime nunca la lee.
# Staging: Supavisor en modo sesión, puerto 5432, usuario postgres.<project_ref>.
MIGRATION_DATABASE_URL=postgresql://postgres:<password>@<host>:<port>/postgres

# Webhook de WhatsApp (Hito 7, DEC-039). Secreto con el que el proveedor firma
# cada POST (X-Hub-Signature-256): el app secret de Meta, de al menos 32
# caracteres. Server-only. Sin esta variable el webhook responde 503.
WHATSAPP_APP_SECRET=<whatsapp-app-secret>
# Token de verificación de la suscripción (GET /api/webhooks/whatsapp). Lo
# inventa el administrador y lo carga igual en Meta (Webhooks → Verify token),
# de al menos 16 caracteres. Server-only. Sin esta variable el GET responde 503.
WHATSAPP_VERIFY_TOKEN=<whatsapp-verify-token>
# Envío de mensajes desde la bandeja (Hito 8, DEC-040): token de acceso a la
# Cloud API de Meta (Authorization: Bearer) con permiso de mensajería sobre la
# cuenta de la línea, de al menos 32 caracteres. Server-only. Sin esta
# variable, POST /api/messages/send responde 503.
WHATSAPP_API_TOKEN=<whatsapp-api-token>
